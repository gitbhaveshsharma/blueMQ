# =============================================
# BlueMQ — Notification Service
# =============================================

# ─── Database (Neon) ───
DATABASE_URL=postgresql://username:password@host:5432/database?sslmode=require

# ─── Redis (BullMQ) ───
# Modes: single | sentinel | cluster
REDIS_MODE=single

# Single / managed endpoint (DigitalOcean Managed Redis, Upstash, Railway, etc.)
REDIS_URL=redis://default:password@host:port
REDIS_DB=0
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_CONNECT_TIMEOUT_MS=10000
REDIS_LAZY_CONNECT=false
REDIS_TLS_ENABLED=false
REDIS_TLS_REJECT_UNAUTHORIZED=true

# Sentinel mode
# REDIS_SENTINELS=10.0.0.11:26379,10.0.0.12:26379,10.0.0.13:26379
# REDIS_SENTINEL_NAME=mymaster
# REDIS_SENTINEL_USERNAME=
# REDIS_SENTINEL_PASSWORD=

# Cluster mode
# REDIS_CLUSTER_NODES=10.0.0.21:6379,10.0.0.22:6379,10.0.0.23:6379
# REDIS_CLUSTER_SCALE_READS=master
# REDIS_CLUSTER_MAX_REDIRECTIONS=16

# ─── OneSignal ───
ONESIGNAL_APP_ID=your_onesignal_app_id
ONESIGNAL_API_KEY=your_onesignal_api_key

# ─── Firebase Cloud Messaging (Push) ───
# Option A: full JSON in one variable
# FIREBASE_SERVICE_ACCOUNT_JSON={"project_id":"...","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}
# Option B: split fields
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── Provider Routing (exactly one true per channel) ───
PROVIDER_PUSH_ONESIGNAL=true
PROVIDER_PUSH_FIREBASE=false

PROVIDER_EMAIL_ONESIGNAL=false
PROVIDER_EMAIL_RESEND=true
PROVIDER_EMAIL_MSG91=false

PROVIDER_SMS_ONESIGNAL=true
PROVIDER_SMS_TWILIO=false
PROVIDER_SMS_MSG91=false

PROVIDER_WHATSAPP_META=true
PROVIDER_WHATSAPP_MSG91=false

PROVIDER_CALL_MSG91=true

# ─── Resend (Email) ───
RESEND_API_KEY=
RESEND_FROM_EMAIL=BlueMQ <noreply@example.com>

# ─── Twilio (SMS) ───
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── MSG91 ───
MSG91_AUTH_KEY=
MSG91_WHATSAPP_NUMBER=
MSG91_FLOW_BASE_URL=https://control.msg91.com/api/v5
MSG91_SMS_FLOW_ID=
MSG91_EMAIL_FLOW_ID=
MSG91_CALL_FLOW_ID=

# ─── Meta WhatsApp Cloud API ───
# Note: Meta API credentials are stored PER-SESSION in the database.
# Each coach provides their OWN Meta API key via the /whatsapp/sessions API.
# No global Meta env vars needed — credentials are per-coach in DB.
# See DOCUMENTATION.md for setup instructions.

# ─── Base URL (for webhook configs) ───
BASE_URL=https://your-bluemq-domain.com

# ─── Service Auth ───
# Used to protect the /apps/register endpoint
SERVICE_API_KEY_SECRET=your_service_api_key_secret

# ─── Server ───
PORT=3001

# ─── Performance Optimizations ───
# Enable batch SQL queries for WhatsApp template resolution
# Reduces sequential queries from 3-9 to 1-2 batch queries
# Recommended: true for production multi-tenant environments
ENABLE_BATCH_TEMPLATE_QUERIES=true


# ─── Redis Template Caching (Phase 2 Performance) ───
# Enable Redis caching for WhatsApp template resolution
# Reduces response time from 2-3s to 0.3-0.5s with cache hits
# Recommended: false initially, enable after load testing
ENABLE_REDIS_TEMPLATE_CACHE=false

# Cache TTL settings (in seconds)
# Fallback entity cache: app-level WhatsApp session lookup
CACHE_TTL_FALLBACK_ENTITY=300

# Template alias cache: notification_type → template_name mapping
CACHE_TTL_TEMPLATE_ALIAS=600

# WhatsApp template cache: full template content
CACHE_TTL_TEMPLATE=1800


# =============================================
# Security Middleware Configuration
# =============================================

# ─── Feature Toggles ───
SECURITY_ENABLE_RATE_LIMITING=true
SECURITY_ENABLE_REQUEST_VALIDATION=true
SECURITY_ENABLE_BRUTE_FORCE_PROTECTION=true
SECURITY_ENABLE_IP_BLACKLIST=true
SECURITY_ENABLE_THREAT_SCORING=true
SECURITY_ENABLE_SECURITY_HEADERS=true
SECURITY_ENABLE_CORS_HARDENING=true

# ─── Rate Limiting (Global - per IP) ───
# Window: 15 minutes, Max: 1000 requests
SECURITY_RATE_LIMIT_GLOBAL_WINDOW_MS=900000
SECURITY_RATE_LIMIT_GLOBAL_MAX=1000

# ─── Rate Limiting (Authentication endpoints) ───
# Window: 15 minutes, Max: 10 requests
SECURITY_RATE_LIMIT_AUTH_WINDOW_MS=900000
SECURITY_RATE_LIMIT_AUTH_MAX=10

# ─── Rate Limiting (Notification endpoint) ───
# Window: 1 minute, Max: 100 requests
SECURITY_RATE_LIMIT_NOTIFY_WINDOW_MS=60000
SECURITY_RATE_LIMIT_NOTIFY_MAX=100

# ─── Rate Limiting (Schedule trigger endpoint) ───
# Window: 1 hour, Max: 30 requests
SECURITY_RATE_LIMIT_SCHEDULES_TRIGGER_WINDOW_MS=3600000
SECURITY_RATE_LIMIT_SCHEDULES_TRIGGER_MAX=30

# ─── Request Validation ───
SECURITY_MAX_URL_LENGTH=2048
SECURITY_MAX_HEADER_SIZE=8192
SECURITY_BLOCK_PHP_PATHS=true
SECURITY_BLOCK_PATH_TRAVERSAL=true
SECURITY_BLOCK_SQL_INJECTION=true
SECURITY_BLOCK_PROTOTYPE_POLLUTION=true

# ─── Brute Force Protection ───
# Cooldown thresholds: failures → cooldown seconds
SECURITY_BRUTE_FORCE_THRESHOLD_1=3
SECURITY_BRUTE_FORCE_COOLDOWN_1=60
SECURITY_BRUTE_FORCE_THRESHOLD_2=5
SECURITY_BRUTE_FORCE_COOLDOWN_2=900
SECURITY_BRUTE_FORCE_THRESHOLD_3=10
SECURITY_BRUTE_FORCE_COOLDOWN_3=3600
SECURITY_BRUTE_FORCE_THRESHOLD_4=20
SECURITY_BRUTE_FORCE_COOLDOWN_4=86400
SECURITY_BRUTE_FORCE_MAX_ATTEMPTS=20
SECURITY_BRUTE_FORCE_TRACKING_WINDOW=86400

# ─── CORS Configuration ───
# Comma-separated list of allowed origins (* = allow all, empty = same-origin only in production)
# Example: https://app.example.com,https://www.example.com
SECURITY_CORS_ALLOWED_ORIGINS=*
SECURITY_CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE
SECURITY_CORS_ALLOWED_HEADERS=Content-Type,Authorization,x-api-key
SECURITY_CORS_CREDENTIALS=true
SECURITY_CORS_MAX_AGE=86400

# ─── Security Headers ───
SECURITY_ENABLE_HSTS=true
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=true
SECURITY_HSTS_PRELOAD=true
SECURITY_ENABLE_CSP=true
SECURITY_REFERRER_POLICY=no-referrer
SECURITY_FRAMEGUARD=deny
SECURITY_XSS_PROTECTION=true
SECURITY_NO_SNIFF=true
SECURITY_HIDE_POWERED_BY=true

# ─── IP Access Control ───
# Comma-separated list of whitelisted IPs (supports CIDR notation)
# Example: 127.0.0.1,::1,192.168.1.0/24
SECURITY_WHITELIST_IPS=127.0.0.1,::1
# Default ban duration in seconds (0 = permanent)
SECURITY_DEFAULT_BAN_DURATION=86400

# ─── Threat Scoring ───
# Point values for different threat types
SECURITY_THREAT_POINTS_PATH_TRAVERSAL=10
SECURITY_THREAT_POINTS_SQL_INJECTION=15
SECURITY_THREAT_POINTS_EXPLOIT_PATH=5
SECURITY_THREAT_POINTS_FAILED_AUTH=2
SECURITY_THREAT_POINTS_RATE_LIMIT=1
SECURITY_THREAT_POINTS_SUSPICIOUS_UA=3
# Auto-ban threshold (ban IP when score reaches this value)
SECURITY_THREAT_THRESHOLD=50
SECURITY_THREAT_AUTO_BAN=true
# Score decay time (score resets after this many hours)
SECURITY_THREAT_DECAY_HOURS=24

# ─── Security Admin API ───
SECURITY_ADMIN_ENABLED=true
# SERVICE_SECRET_KEY is already defined above for /apps/register
# It's also used for security admin endpoints

# =============================================
# Security Middleware - Phase 2 (Advanced Protection)
# =============================================
# PRODUCTION-SAFE: Disabled by default to avoid breaking existing deployments
# Enable gradually after monitoring Phase 1 metrics

# ─── IP Blacklist Management (DISABLED by default) ───
# Dynamic IP blocking based on threat score or manual bans
# WARNING: Only enable after Phase 1 is stable and monitored
SECURITY_ENABLE_IP_BLACKLIST=false

# ─── Brute Force Protection (DISABLED by default) ───
# Exponential backoff for authentication failures
# WARNING: Test in staging first to ensure legitimate users aren't affected
SECURITY_ENABLE_BRUTE_FORCE_PROTECTION=false

# ─── Threat Scoring (DISABLED by default) ───
# Cumulative risk scoring with auto-ban feature
# WARNING: Monitor false positive rate before enabling auto-ban
SECURITY_ENABLE_THREAT_SCORING=false
# Auto-ban disabled by default even when threat scoring is enabled
SECURITY_THREAT_AUTO_BAN=false

# ─── CORS Hardening (DISABLED by default) ───
# Whitelist-based CORS policy
# WARNING: Add all legitimate frontend origins before enabling
# When disabled, falls back to permissive CORS
SECURITY_ENABLE_CORS_HARDENING=false

# ──────────────────────────────────────────────
# Phase 2 Gradual Rollout Recommendation:
# 
# Week 1: Enable only threat scoring (no auto-ban)
#   SECURITY_ENABLE_THREAT_SCORING=true
#   SECURITY_THREAT_AUTO_BAN=false
#   Monitor: security:threat:* keys in Redis
#
# Week 2: Enable brute force protection
#   SECURITY_ENABLE_BRUTE_FORCE_PROTECTION=true
#   Monitor: auth failure rates, cooldown triggers
#
# Week 3: Enable IP blacklist (manual only)
#   SECURITY_ENABLE_IP_BLACKLIST=true
#   SECURITY_THREAT_AUTO_BAN=false
#   Monitor: false positive reports
#
# Week 4: Enable auto-ban (if no false positives)
#   SECURITY_THREAT_AUTO_BAN=true
#   Monitor: banned IPs, unban requests
#
# Week 5+: Enable CORS hardening (after confirming all origins)
#   SECURITY_ENABLE_CORS_HARDENING=true
#   SECURITY_CORS_ALLOWED_ORIGINS=https://your-app.com
# ──────────────────────────────────────────────
